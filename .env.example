# Module 1 environment overrides (optional -- the primary config is config.yaml).
# Copy to `.env` / export in your shell. Nested keys use a double underscore.
# Precedence: config.yaml < these KGB_* vars < CLI flags.

# ---- LLM semantic enrichment (MANDATORY unless --skip-enrichment) ----
# There is NO heuristic fallback: model + api_key are required to enrich.
KGB_LLM__PROVIDER=openai
KGB_LLM__MODEL=gpt-4o-mini
KGB_LLM__API_KEY=
# Any OpenAI-compatible endpoint (also reads OPENAI_API_KEY / OPENAI_API_BASE):
KGB_LLM__BASE_URL=

# ---- Skip enrichment (build structural graph only) ----
# KGB_ENRICH=0

# ---- Deployment collector (Kubernetes) -- currently a stub ----
# KGB_DEPLOYMENT__ENABLED=1
# KGB_DEPLOYMENT__KUBECONFIG=~/.kube/config
# KGB_DEPLOYMENT__CONTEXT=my-cluster
# KGB_DEPLOYMENT__NAMESPACES=["prod","payments"]

# ---- Runtime collector -- currently a stub ----
# KGB_RUNTIME__ENABLED=1
# KGB_RUNTIME__PROMETHEUS_URL=http://prometheus.internal:9090
