# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Env / secrets
.env
# Local runtime config (may contain API keys); the tracked template is config.example.yaml
/config.yaml
/config.local.yaml

# Build outputs (regenerated by `kgb build`)
out/
*.log

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

# Node.js (scip-python installed locally via npm)
node_modules/

# Joern CPG artifacts
*.cpg
cpg.bin

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# Deprecated legacy code (kept for reference only, not tracked)
deprecated/

# SCIP index files (regenerated on each build)
*.scip

# Sample repo generated outputs
examples/sample_repo/__pycache__/
examples/comprehensive_test_repo/**/__pycache__/
pytest-of-xueht
