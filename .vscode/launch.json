{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "kgb build (sample_repo)",
            "type": "debugpy",
            "request": "launch",
            "module": "kg_builder.cli",
            "args": [
                "build",
                "examples/sample_repo",
                "-o", "out/knowledge_graph.json",
                "--skip-enrichment",
                "-v"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PATH": "${workspaceFolder}/node_modules/.bin:/home/xueht/bin/joern/joern-cli/bin:/home/xueht/miniconda3/envs/toolsafe/bin:${env:PATH}"
            }
        },
        {
